{
  auto_https off
  admin off
}

:80 {
  encode zstd gzip
  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "geolocation=(), microphone=(), camera=()"
  }
  @api path /api/*
  handle @api {
    reverse_proxy api:3000
  }
  handle {
    try_files {path} /index.html
    file_server
  }
}
