POSTGRES_DB=orio
POSTGRES_USER=orio
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://orio:replace-with-a-long-random-password@db:5432/orio
WEB_PORT=8080
# Local Docker defaults. Production must use an HTTPS PUBLIC_ORIGIN and COOKIE_SECURE=true.
REGISTRATION_MODE=open
# Only needed for REGISTRATION_MODE=invite. Keep it server-side and use a long random value.
INVITE_CODES=
SESSION_TTL_DAYS=30
COOKIE_SECURE=false
# Set this when ORIO is exposed through HTTPS, e.g. https://orio.example.com.
PUBLIC_ORIGIN=
TRUST_PROXY=false
# Password reset email via Resend. Verify the sender domain in Resend first.
RESEND_API_KEY=
RESEND_FROM="ORIO <no-reply@example.com>"
PASSWORD_RESET_TTL_MINUTES=30
